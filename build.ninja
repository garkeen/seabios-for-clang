# Generated by scripts/gen-ninja.py -- do not edit.
ninja_required_version = 1.10

bs_src_flag = -fmacro-prefix-map=.\src=./src -fmacro-prefix-map=.\vgasrc=./vgasrc

rule mktmp
  command = cp $in $out
  description = GEN $out

rule cc16
  command = D:/LLVM/bin/clang --target=i386-unknown-elf -I. $flags $bs_src_flag -MF $out.d -c $out.tmp.c -o $out
  description = CC16 $out
  deps = gcc
  depfile = $out.d

rule cc32flat
  command = D:/LLVM/bin/clang --target=i386-unknown-elf -I. $flags $bs_src_flag -MF $out.d -c $out.tmp.c -o $out
  description = CC32FLAT $out
  deps = gcc
  depfile = $out.d

rule cc32seg
  command = D:/LLVM/bin/clang --target=i386-unknown-elf -I. $flags $bs_src_flag -MF $out.d -c $out.tmp.c -o $out
  description = CC32SEG $out
  deps = gcc
  depfile = $out.d

rule as
  command = D:/LLVM/bin/clang --target=i386-unknown-elf $flags -MF $out.d -c -D__ASSEMBLY__ $in -o $out
  description = AS $out
  deps = gcc
  depfile = $out.d

rule asmoffsets
  command = C:/Program Files/Git/usr/bin/bash.exe -c "mkdir -p out/src && /d/LLVM/bin/clang --target=i386-unknown-elf $flags -S -c src/asm-offsets.c -o out/src/asm-offsets.s && ./scripts/gen-offsets.sh out/src/asm-offsets.s out/asm-offsets.h"
  description = ASMOFFSETS $out

rule ldscripts
  command = "C:/Program Files/Git/usr/bin/bash.exe" -c "/d/Python/Python312/python.exe ./scripts/buildversion.py -e '' -t '/d/LLVM/bin/clang;/d/LLVM/bin/clang;/d/LLVM/bin/ld.lld;/d/LLVM/bin/llvm-objcopy;D:/LLVM/bin/llvm-readobj;/d/LLVM/bin/llvm-strip' out/autoversion.h && /d/LLVM/bin/clang --target=i386-unknown-elf $flags -c src/version.c -o out/version.o && /d/LLVM/bin/ld.lld -melf_i386 -r out/ccode32flat.o out/version.o -o out/code32flat.o && /d/LLVM/bin/ld.lld -melf_i386 -r out/ccode16.o out/romlayout.o -o out/code16.o && /d/Python/Python312/python.exe ./scripts/llvmdump.py out/code32flat.o D:/LLVM/bin > out/code32flat.o.objdump && /d/Python/Python312/python.exe ./scripts/llvmdump.py out/code32seg.o D:/LLVM/bin > out/code32seg.o.objdump && /d/Python/Python312/python.exe ./scripts/llvmdump.py out/code16.o D:/LLVM/bin > out/code16.o.objdump && /d/Python/Python312/python.exe ./scripts/layoutrom.py out/code16.o.objdump out/code32seg.o.objdump out/code32flat.o.objdump out/autoconf.h out/romlayout16.lds out/romlayout32seg.lds out/romlayout32flat.lds"
  description = LAYOUT $out

rule ldrom16
  command = D:/LLVM/bin/ld.lld -melf_i386 --no-check-sections -s -T out/romlayout16.lds $in -o $out
  description = LD $out

rule ldrom32seg
  command = D:/LLVM/bin/ld.lld -melf_i386 --no-check-sections -s -T out/romlayout32seg.lds $in -o $out
  description = LD $out

rule noexec
  command = "C:/Program Files/Git/usr/bin/bash.exe" -c "/d/LLVM/bin/llvm-strip --strip-unneeded $stem -o $stem.strip.o && /d/Python/Python312/python.exe ./scripts/ldnoexec.py $stem.strip.o $out"
  description = NOEXEC $out

rule ldrom
  command = D:/LLVM/bin/ld.lld -melf_i386 -N -T out/romlayout32flat.lds out/rom16.noexec.o out/rom32seg.noexec.o out/code32flat.o -o $out
  description = LD $out

rule rawbin
  command = "C:/Program Files/Git/usr/bin/bash.exe" -c "/d/Python/Python312/python.exe ./scripts/llvmdump.py $in D:/LLVM/bin > $in.objdump && /d/LLVM/bin/llvm-objcopy -O binary $in out/bios.bin.raw"
  description = RAW $out

rule checkrom
  command = D:/Python/Python312/python.exe ./scripts/checkrom.py out/rom.o.objdump 0 out/bios.bin.raw $out
  description = CHECKROM $out

rule cp
  command = cp $in $out
  description = CP $out

rule cpplds
  command = "C:/Program Files/Git/usr/bin/bash.exe" -c "/d/LLVM/bin/clang --target=i386-unknown-elf -E -P -D__ASSEMBLY__ -Iout -Isrc $in -o $out"
  description = CPP $out

rule ccvga1
  command = D:/LLVM/bin/clang --target=i386-unknown-elf -I. $flags $bs_src_flag -MF $out.d -c $in -o $out
  description = CCVGA $out
  deps = gcc
  depfile = $out.d

rule vgaversion
  command = "C:/Program Files/Git/usr/bin/bash.exe" -c "/d/Python/Python312/python.exe ./scripts/buildversion.py -e '' -t 'clang;clang;ld.lld;llvm-objcopy;llvm-readobj;llvm-strip' out/autovgaversion.h"
  description = VGAVERSION $out

rule ldvga
  command = D:/LLVM/bin/ld.lld -melf_i386 --gc-sections -T out/vgasrc/vgalayout.lds $in -o $out
  description = LDVGA $out

rule rawvga
  command = "C:/Program Files/Git/usr/bin/bash.exe" -c "/d/LLVM/bin/llvm-objcopy -O binary $in out/vgabios.bin.raw"
  description = RAWVGA $out

rule buildrom
  command = D:/Python/Python312/python.exe ./scripts/buildrom.py $in $out
  description = BUILDROM $out

# tmp.c inputs
build out/ccode16.o.tmp.c: mktmp out/.includes16.txt
build out/ccode32flat.o.tmp.c: mktmp out/.includes32flat.txt
build out/code32seg.o.tmp.c: mktmp out/.includes32seg.txt

# whole-program compiles (fresh, correct section names)
build out/ccode16.o: cc16 out/ccode16.o.tmp.c | out/autoconf.h
  flags = -Iout/ -Isrc -Os -MD -Wall -Wno-strict-aliasing -Wold-style-definition -Wtype-limits -m32 -march=i386 -mregparm=3 -mstack-alignment=2 -minline-all-stringops -fomit-frame-pointer -freg-struct-return -ffreestanding -fno-delete-null-pointer-checks -ffunction-sections -fdata-sections -fno-common -fno-pie -fno-stack-protector -Wno-address-of-packed-member -Wno-array-bounds -fcf-protection=none -Wno-ignored-optimization-argument -DMODESEGMENT=1 -fno-defer-pop -fno-jump-tables -DMODE16=1 -m16 -fno-inline
build out/ccode32flat.o: cc32flat out/ccode32flat.o.tmp.c | out/autoconf.h
  flags = -Iout/ -Isrc -Os -MD -Wall -Wno-strict-aliasing -Wold-style-definition -Wtype-limits -m32 -march=i386 -mregparm=3 -mstack-alignment=2 -minline-all-stringops -fomit-frame-pointer -freg-struct-return -ffreestanding -fno-delete-null-pointer-checks -ffunction-sections -fdata-sections -fno-common -fno-pie -fno-stack-protector -Wno-address-of-packed-member -Wno-array-bounds -fcf-protection=none -Wno-ignored-optimization-argument -DMODE16=0 -DMODESEGMENT=0
build out/code32seg.o: cc32seg out/code32seg.o.tmp.c | out/autoconf.h
  flags = -Iout/ -Isrc -Os -MD -Wall -Wno-strict-aliasing -Wold-style-definition -Wtype-limits -m32 -march=i386 -mregparm=3 -mstack-alignment=2 -minline-all-stringops -fomit-frame-pointer -freg-struct-return -ffreestanding -fno-delete-null-pointer-checks -ffunction-sections -fdata-sections -fno-common -fno-pie -fno-stack-protector -Wno-address-of-packed-member -Wno-array-bounds -fcf-protection=none -Wno-ignored-optimization-argument -DMODESEGMENT=1 -fno-defer-pop -fno-jump-tables -DMODE16=0

# 16-bit assembly entry code
build out/romlayout.o: as src/romlayout.S | out/autoconf.h out/asm-offsets.h
  flags = -Iout/ -Isrc -Os -MD -Wall -Wno-strict-aliasing -Wold-style-definition -Wtype-limits -m32 -march=i386 -mregparm=3 -mstack-alignment=2 -minline-all-stringops -fomit-frame-pointer -freg-struct-return -ffreestanding -fno-delete-null-pointer-checks -ffunction-sections -fdata-sections -fno-common -fno-pie -fno-stack-protector -Wno-address-of-packed-member -Wno-array-bounds -fcf-protection=none -Wno-ignored-optimization-argument -DMODESEGMENT=1 -fno-defer-pop -fno-jump-tables -DMODE16=1 -m16 -fno-inline

# assembler offsets (pure LLVM: clang -S + gen-offsets.sh sed)
build out/asm-offsets.h: asmoffsets src/asm-offsets.c | out/autoconf.h
  flags = -Iout/ -Isrc -Os -MD -Wall -Wno-strict-aliasing -Wold-style-definition -Wtype-limits -m32 -march=i386 -mregparm=3 -mstack-alignment=2 -minline-all-stringops -fomit-frame-pointer -freg-struct-return -ffreestanding -fno-delete-null-pointer-checks -ffunction-sections -fdata-sections -fno-common -fno-pie -fno-stack-protector -Wno-address-of-packed-member -Wno-array-bounds -fcf-protection=none -Wno-ignored-optimization-argument -DMODESEGMENT=1 -fno-defer-pop -fno-jump-tables -DMODE16=1 -m16 -fno-inline

# layout + partial links (single rule keeps the -j dependency chain honest)
build out/romlayout16.lds: ldscripts out/ccode32flat.o out/code32seg.o out/ccode16.o out/romlayout.o src/version.c | scripts/layoutrom.py scripts/buildversion.py scripts/llvmdump.py
  flags = -Iout/ -Isrc -Os -MD -Wall -Wno-strict-aliasing -Wold-style-definition -Wtype-limits -m32 -march=i386 -mregparm=3 -mstack-alignment=2 -minline-all-stringops -fomit-frame-pointer -freg-struct-return -ffreestanding -fno-delete-null-pointer-checks -ffunction-sections -fdata-sections -fno-common -fno-pie -fno-stack-protector -Wno-address-of-packed-member -Wno-array-bounds -fcf-protection=none -Wno-ignored-optimization-argument -DMODE16=0 -DMODESEGMENT=0
build out/romlayout32seg.lds out/romlayout32flat.lds out/code32flat.o out/code16.o: phony out/romlayout16.lds

build out/rom16.o: ldrom16 out/code16.o | out/romlayout16.lds
build out/rom32seg.o: ldrom32seg out/code32seg.o | out/romlayout32seg.lds

build out/rom16.noexec.o: noexec out/rom16.o
  stem = out/rom16.o
build out/rom32seg.noexec.o: noexec out/rom32seg.o
  stem = out/rom32seg.o

build out/rom.o: ldrom out/rom16.noexec.o out/rom32seg.noexec.o out/code32flat.o | out/romlayout32flat.lds

build out/bios.bin.raw: rawbin out/rom.o | scripts/llvmdump.py
build out/bios.bin.prep: checkrom out/bios.bin.raw | scripts/checkrom.py
build out/bios.bin: cp out/bios.bin.prep

# VGA BIOS image: the option ROM a display card carries, not part of
# bios.bin (upstream Makefile "VGA build rules", CONFIG_BUILD_VGABIOS).
build out/vgaccode16.o.tmp.c: mktmp out/.includesvga.txt
build out/vgaccode16.o: cc16 out/vgaccode16.o.tmp.c | out/autoconf.h
  flags = -Iout/ -Isrc -Os -MD -Wall -Wno-strict-aliasing -Wold-style-definition -Wtype-limits -m32 -march=i386 -mregparm=3 -mstack-alignment=2 -minline-all-stringops -fomit-frame-pointer -freg-struct-return -ffreestanding -fno-delete-null-pointer-checks -ffunction-sections -fdata-sections -fno-common -fno-pie -fno-stack-protector -Wno-address-of-packed-member -Wno-array-bounds -fcf-protection=none -Wno-ignored-optimization-argument -DMODESEGMENT=1 -fno-defer-pop -fno-jump-tables -DMODE16=1 -m16 -fno-inline
build out/vgaentry.o: as vgasrc/vgaentry.S | out/autoconf.h out/asm-offsets.h
  flags = -Iout/ -Isrc -Os -MD -Wall -Wno-strict-aliasing -Wold-style-definition -Wtype-limits -m32 -march=i386 -mregparm=3 -mstack-alignment=2 -minline-all-stringops -fomit-frame-pointer -freg-struct-return -ffreestanding -fno-delete-null-pointer-checks -ffunction-sections -fdata-sections -fno-common -fno-pie -fno-stack-protector -Wno-address-of-packed-member -Wno-array-bounds -fcf-protection=none -Wno-ignored-optimization-argument -DMODESEGMENT=1 -fno-defer-pop -fno-jump-tables -DMODE16=1 -m16 -fno-inline
build out/vgasrc/vgalayout.lds: cpplds vgasrc/vgalayout.lds.S
build out/autovgaversion.h: vgaversion scripts/buildversion.py
build out/vgaversion.o: ccvga1 vgasrc/vgaversion.c | out/autovgaversion.h
  flags = -Iout/ -Isrc -Os -MD -Wall -Wno-strict-aliasing -Wold-style-definition -Wtype-limits -m32 -march=i386 -mregparm=3 -mstack-alignment=2 -minline-all-stringops -fomit-frame-pointer -freg-struct-return -ffreestanding -fno-delete-null-pointer-checks -ffunction-sections -fdata-sections -fno-common -fno-pie -fno-stack-protector -Wno-address-of-packed-member -Wno-array-bounds -fcf-protection=none -Wno-ignored-optimization-argument -DMODESEGMENT=1 -fno-defer-pop -fno-jump-tables -DMODE16=1 -m16 -fno-inline
build out/vgarom.o: ldvga out/vgaccode16.o out/vgaentry.o out/vgaversion.o | out/vgasrc/vgalayout.lds
build out/vgabios.bin.raw: rawvga out/vgarom.o
build out/vgabios.bin: buildrom out/vgabios.bin.raw | scripts/buildrom.py

default out/bios.bin out/vgabios.bin
