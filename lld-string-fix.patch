diff --git a/build.ninja b/build.ninja
--- a/build.ninja
+++ b/build.ninja
@@ -25,6 +25,23 @@
   deps = gcc
   depfile = $out.d
 
+# The 16-bit and 32seg links bake string addresses into `push $str` immediates,
+# but lld folds every SHF_MERGE .rodata.str1.1 input (from all links) into one
+# synthesized section and places only that copy, which leaves those immediates
+# pointing at the copy it discarded. Dropping the MERGE/STRINGS flags on those
+# two objects' string section makes it an ordinary readonly section, so there is
+# nothing to fold and each link keeps the copy its own script placed.
+rule cc16nomerge
+  command = cmd.exe /c "D:/LLVM/bin/clang --target=i386-unknown-elf -I. $flags $bs_src_flag -MF $out.d -c $out.tmp.c -o $out && D:/mingw64/bin/objcopy.exe --set-section-flags .rodata.str1.1=alloc,load,readonly,contents $out"
+  description = CC16NM $out
+  deps = gcc
+  depfile = $out.d
+
+rule cc32segnomerge
+  command = cmd.exe /c "D:/LLVM/bin/clang --target=i386-unknown-elf -I. $flags $bs_src_flag -MF $out.d -c $out.tmp.c -o $out && D:/mingw64/bin/objcopy.exe --set-section-flags .rodata.str1.1=alloc,load,readonly,contents $out"
+  description = CC32SEGNM $out
+  deps = gcc
+  depfile = $out.d
 rule as
   command = D:/LLVM/bin/clang --target=i386-unknown-elf $flags -MF $out.d -c -D__ASSEMBLY__ $in -o $out
   description = AS $out
